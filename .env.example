# Salin menjadi .env (atau isi di Vercel > Settings > Environment Variables). JANGAN commit nilai asli.

# Koneksi Postgres (Supabase, pooler transaction mode port 6543, role kpsp_app). Kosongkan = SQLite lokal.
DATABASE_URL=postgresql://kpsp_app.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Kunci acak untuk menandatangani cookie sesi login. Buat: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# --- Opsional (pengembangan lokal) ---
# KPSP_DB=app/instance/kpsp.db      # lokasi file SQLite lokal
# ADMIN_PASSWORD=                   # password admin awal SQLite (default: acak, dicatat di instance/admin_awal.txt)
# HOST=127.0.0.1                    # 0.0.0.0 agar bisa dibuka dari HP di jaringan yang sama
# PORT=5000
# DEBUG=1
